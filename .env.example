# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Databases ---
DATABASE_URL=postgresql+psycopg2://canpath:canpath@localhost:5432/canpath
